# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME="KnowledgeHub AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"   # development | staging | production
DEBUG=true

# ─── API ────────────────────────────────────────────────────────────────────────
API_V1_PREFIX="/api/v1"
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+psycopg2://knowledgehub:knowledgehub@localhost:5432/knowledgehub"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Auth / JWT ─────────────────────────────────────────────────────────────────
SECRET_KEY="CHANGE_ME_use_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_API_KEY="your-google-gemini-api-key"
GEMINI_GENERATION_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="models/text-embedding-004"
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_GENERATION_TIMEOUT=60
GEMINI_MAX_RETRIES=3

# ─── RAG Pipeline ───────────────────────────────────────────────────────────────
CHUNK_SIZE=5000
CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7

# ─── Storage ────────────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS="pdf"
